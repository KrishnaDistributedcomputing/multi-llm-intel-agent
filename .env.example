# Generate separate secrets with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=
LITELLM_MASTER_KEY=
ALLOW_CLOUD=false
# Shared allowance across chat, document excerpts, and verification probes.
CLOUD_DAILY_BUDGET_USD=1
CLOUD_CALLS_PER_MINUTE=6
CLOUD_VERIFY_INTERVAL_SECONDS=3600
# After downloading and approving the model, set its full sha256 digest (see README).
LOCAL_MODEL_DIGEST=
ACR_LOGIN_SERVER=
IMAGE_TAG=0.1.0
AGENT_PORT=8000
# Optional public HTTPS demo; hostname only, no scheme or trailing slash.
PUBLIC_HOST=
# Credentials are supplied only to the gateway.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AZURE_API_KEY=
COMPATIBLE_API_KEY=
# Optional Temporal settings are supplied by compose.temporal.yaml.
# For direct local development, API and worker must share DOCUMENT_DATA_PATH.
TEMPORAL_ENABLED=false
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=document-processing
DOCUMENT_DATA_PATH=data/documents
DOCUMENT_AGENT_URL=http://127.0.0.1:8000
