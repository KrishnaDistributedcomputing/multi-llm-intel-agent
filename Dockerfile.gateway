FROM python:3.11-slim-bookworm
ARG PIP_INDEX_URL=https://pypi.org/simple
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 LITELLM_TELEMETRY=False DO_NOT_TRACK=1
WORKDIR /app
COPY requirements-gateway.txt ./
RUN pip install --no-cache-dir --require-hashes -r requirements-gateway.txt \
    && groupadd --gid 10001 gateway && useradd --uid 10001 --gid gateway --create-home gateway
COPY agent/__init__.py agent/config.py ./agent/
COPY gateway ./gateway
COPY models.yaml ./
USER 10001:10001
EXPOSE 4000
ENTRYPOINT ["python", "-m", "gateway.start"]
